RPC_URL=https://your-quicknode-endpoint.example
DATABASE_URL=postgresql://iseeu:iseeu@localhost:5432/iseeu
# DB_POOL_MAX=20
# DB_CONNECT_TIMEOUT_MS=5000
# Docker Compose development credentials; keep DATABASE_URL in sync if these change.
# POSTGRES_DB=iseeu
# POSTGRES_USER=iseeu
# POSTGRES_PASSWORD=iseeu
# POSTGRES_PORT=5432  # host port; change it (and DATABASE_URL) if 5432 is taken
# RPC_FALLBACK_URLS=https://fallback-one.example,https://fallback-two.example
# PORT=3000
# LOG_LEVEL=warn
# LOG_SOURCE=rpc                  # rpc (default) | auto | hypersync; HyperSync is experimental and opt-in
# HYPERSYNC_API_KEY=              # optional; leave empty for RPC-only backfills
# HYPERSYNC_URL=https://eth.hypersync.xyz
# HYPERSYNC_MAX_RANGE=100000
# HYPERSYNC_TIMEOUT_MS=30000
# FINALIZED_MAX_NO_PROGRESS_MS=1200000
# MAX_HEAD_AGE_MS=1800000
# ETH_LOGS_MAX_RANGE=3000
# ETH_LOGS_MIN_RANGE=500
# ETH_SCAN_CONCURRENCY=8
# RPC_TIMEOUT_MS=15000
# RPC_MAX_ATTEMPTS=6
# ETH_MULTICALL_BATCH=1000
# RPC_MAX_RPS=20
# ETH_FOLLOWER_MAX_RANGE=500
# FOLLOWER_POLL_MS=390000  # 30000 when TAIL_ENABLED=false; with the tail it is a fallback (the tail wakes it per epoch)
# FOLLOWER_MAX_LAG_BLOCKS=96
# TAIL_ENABLED=true
# TAIL_MAX_DEPTH=64
# TAIL_POLL_OFFSETS_MS=2500,5000,9000
# TAIL_MAX_AHEAD_BLOCKS=1024  # stop appending this far above the finalized cursor (finality stall)
# TAIL_MAX_TIP_AGE_MS=60000  # serve finalized + tailError when the tail tip block is older (5 slots)
# ACTIVE_ACCOUNT_TTL_MS=300000
# BALANCE_REFRESH_MS=60000
# REQUEST_DEADLINE_MS=10000
# BACKFILL_CONCURRENCY=4
# BACKFILL_QUEUE=64
# REQUEST_RPC_CONCURRENCY=16
# REQUEST_RPC_QUEUE=256
